# Copy this file to `.env` (same folder) and fill in real values.
# NEVER commit the real `.env` file.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local dev default (sqlite). docker-compose overrides this to Postgres.
DATABASE_URL=sqlite:///./database.db

REDIS_URL=redis://localhost:6379/0
SETTLEMENT_QUEUE_NAME=settlement

FRAUD_ML_SERVICE_URL=http://localhost:9100

FRAUD_RISK_THRESHOLD=60
OTP_REQUIRED_RISK_THRESHOLD=40

CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

FIREBASE_CREDENTIALS_PATH=./firebase/firebase-key.json

SETTLEMENT_MIN_DELAY_SECONDS=1
SETTLEMENT_MAX_DELAY_SECONDS=3
SETTLEMENT_STUCK_PROBABILITY=0.12
SETTLEMENT_FAIL_PROBABILITY=0.05

DEMO_MODE=true
